{
  "name": "dsh-desktop",
  "version": "1.0.0",
  "description": "DeepSeek Harness desktop wrapper: bundled server + UI with tray",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package:mac": "electron-builder --mac dir --universal",
    "dist:mac": "electron-builder --mac dmg --universal",
    "icon:mac": "node scripts/convert-mac-icon.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.6"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "26.15.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3"
  },
  "build": {
    "appId": "com.deepseek.harness.desktop",
    "productName": "DeepSeek Harness",
    "asar": true,
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/node-pty/**"
    ],
    "files": [
      "main.js",
      "package.json",
      "assets/**/*",
      "!node_modules/sharp/**",
      "!node_modules/@img/**",
      "!node_modules/png-to-ico/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/deepseek.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    }
  }
}
